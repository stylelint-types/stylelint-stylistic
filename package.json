{
  "name": "@stylelint-types/stylelint-stylistic",
  "version": "5.3.0",
  "description": "TypeScript definitions for stylelint-define-config",
  "keywords": [
    "config",
    "configuration",
    "define-config",
    "scss",
    "stylelint",
    "stylelint-config",
    "stylelint-stylistic",
    "stylelintconfig",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/stylelint-types/stylelint-stylistic#readme",
  "bugs": "https://github.com/stylelint-types/stylelint-stylistic/issues",
  "license": "MIT",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/stylelint-types/stylelint-stylistic.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint . --type-check --type-aware && oxfmt . --check",
    "format": "oxlint . --type-check --type-aware --fix && oxfmt .",
    "build": "tsdown",
    "release:publish": "pnpm publish",
    "release:changelog": "conventional-changelog -p angular && oxfmt ./CHANGELOG.md",
    "release": "bumpp package.json --execute=\"pnpm release:changelog\" --commit --all --push --tag"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.9.2",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "stylelint": "^17.15.0",
    "stylelint-define-config": "^17.14.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "stylelint": ">=17",
    "stylelint-define-config": ">=17"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
